# Transcription Pipeline Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Groq API Key for transcription services
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API Key for AI processing
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Hugging Face Token for model access
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Syncthing ingester (optional, for mini-pc synced input)
SYNC_INGEST_API_BASE_URL=http://app:8000
SYNC_INGEST_INBOX_DIR=/app/sync_inbox
SYNC_INGEST_INGESTED_DIR=/app/sync_inbox/_ingested
SYNC_INGEST_FAILED_DIR=/app/sync_inbox/_failed
SYNC_INGEST_STATE_DB=/app/data/sync_ingest.db
SYNC_INGEST_POLL_SECONDS=10
SYNC_INGEST_STABLE_SECONDS=8
SYNC_INGEST_MAX_FILE_SIZE_MB=500
SYNC_INGEST_FOLDER_MAP=meeting:meeting,supervision:supervision,client:client,braindump:braindump,kate:social_work_lecture,keira:business_lecture
SYNC_INGEST_LEGACY_DIRS=/app/uploads/kate,/app/uploads/keira
